{
  "name": "timetracking-backend",
  "version": "1.0.0",
  "description": "Time tracking API with SQLite, Better Auth, and multi-tenancy",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nodemon --exec 'node --experimental-transform-types' src/index.js",
    "start": "prisma generate && prisma db push && node --experimental-transform-types src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-transform-types prisma/seed.js"
  },
  "prisma": {
    "seed": "node --experimental-transform-types prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "better-auth": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "prisma": "^7.4.0",
    "resend": "^6.9.2",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
