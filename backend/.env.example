# Database - Railway provides this automatically when you add a Postgres database
# Local development: Run `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timetracking"

# Better Auth - MUST be changed in production (minimum 32 characters)
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Better Auth URL - Set to your Railway backend URL in production
# Example: https://timetracking-backend-production.up.railway.app
BETTER_AUTH_URL="http://localhost:3001"

# Server port - Railway sets this automatically via PORT env var
PORT=3001

# Frontend URL - for CORS (set to your Railway frontend URL in production)
# Example: https://timetracking-frontend-production.up.railway.app
FRONTEND_URL="http://localhost:5173"

# Resend (Email service) - Get your API key at https://resend.com
RESEND_API_KEY=""
# From email - Use your verified domain in production
# Development: noreply@resend.dev (Resend's test domain)
# Production: noreply@yourdomain.com
FROM_EMAIL="Time Tracker <noreply@resend.dev>"
# App name shown in emails
APP_NAME="Time Tracker"
