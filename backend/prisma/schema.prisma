generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Better Auth Core Tables
// ==========================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  phone         String?
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // Admin plugin fields
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  timeEntries TimeEntry[]

  // Software catalog submissions
  submittedSoftware SoftwareCatalog[]

  @@map("users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @map("active_organization_id")
  // Admin plugin field for impersonation
  impersonatedBy       String?  @map("impersonated_by")

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ==========================================
// Better Auth Organization Tables
// ==========================================

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  metadata  String?

  members       Member[]
  invitations   Invitation[]
  projects      Project[]
  timeEntries   TimeEntry[]
  tickets       SupportTicket[]
  notifications Notification[]
  emailRules    EmailRule[]

  @@map("organizations")
}

model Member {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String // "owner", "admin", "member", "client"
  createdAt      DateTime     @default(now()) @map("created_at")

  // Ticket relations
  ticketsAsClient   SupportTicket[]    @relation("TicketClient")
  ticketsAsOwner    SupportTicket[]    @relation("TicketOwner")
  ticketComments    TicketComment[]
  ticketAttachments TicketAttachment[]

  // Project relations
  projectAssignments      ProjectAssignment[]
  defaultAssigneeProjects Project[]           @relation("ProjectDefaultAssignee")

  // Software catalog relations
  projectSoftwareAdded        ProjectSoftware[]       @relation("ProjectSoftwareAddedBy")
  projectSoftwareAdmins       ProjectSoftwareAdmin[]
  softwareRequestsAsRequester SoftwareAccessRequest[] @relation("SoftwareRequester")
  softwareRequestsAsAssignee  SoftwareAccessRequest[] @relation("SoftwareRequestAssignee")
  softwareRequestsAsReviewer  SoftwareAccessRequest[] @relation("SoftwareReviewer")

  // Notification relations
  notifications Notification[]

  // Email participant relations
  emailParticipations TicketEmailParticipant[]

  @@unique([organizationId, userId])
  @@map("members")
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memberId, projectId])
  @@map("project_assignments")
}

model Invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String // "admin" or "member"
  status         String       @default("pending") // "pending", "accepted", "rejected", "canceled"
  expiresAt      DateTime     @map("expires_at")
  inviterId      String       @map("inviter_id")
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("invitations")
}

// ==========================================
// Application Tables (Org-scoped)
// ==========================================

model Project {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  projectCode       String       @map("project_code")
  clientName        String?      @map("client_name")
  description       String?
  isActive          Boolean      @default(true) @map("is_active")
  defaultAssigneeId String?      @map("default_assignee_id")
  defaultAssignee   Member?      @relation("ProjectDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  // Priority-based due date settings (in days, null means no auto due date)
  dueDateLowDays    Int? @map("due_date_low_days")
  dueDateMediumDays Int? @map("due_date_medium_days")
  dueDateHighDays   Int? @map("due_date_high_days")
  dueDateUrgentDays Int? @map("due_date_urgent_days")

  // Auto-reply settings for email-originated tickets
  autoReplyEnabled Boolean @default(false) @map("auto_reply_enabled")
  autoReplyHtml    String? @map("auto_reply_html") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  timeEntries        TimeEntry[]
  tickets            SupportTicket[]
  projectAssignments ProjectAssignment[]
  stages             TicketStage[]
  emailRules         EmailRule[]

  // Software catalog
  projectSoftware ProjectSoftware[]

  @@unique([organizationId, projectCode])
  @@map("projects")
}

// ==========================================
// Email-to-Ticket System
// ==========================================

enum EmailRuleMatchType {
  EXACT_ADDRESS // Match exact recipient email (e.g., "support@client.com")
  DOMAIN // Match sender domain (e.g., "@client.com")
  CATCH_ALL // Match any email not caught by other rules
}

enum InboundEmailStatus {
  PENDING // Received but not yet processed
  PROCESSED // Successfully created ticket/comment
  FAILED // Processing failed
  IGNORED // Spam or duplicate
}

model EmailRule {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id")
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  matchType  EmailRuleMatchType @map("match_type")
  matchValue String?            @map("match_value") // Email or domain (null for CATCH_ALL)
  priority   Int                @default(0)
  isActive   Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inboundEmails InboundEmail[]

  @@index([organizationId, isActive])
  @@index([matchType, matchValue])
  @@map("email_rules")
}

model InboundEmail {
  id              String             @id @default(cuid())
  messageId       String             @unique @map("message_id")
  inReplyTo       String?            @map("in_reply_to")
  subject         String
  from            String
  fromName        String?            @map("from_name")
  to              String
  htmlBody        String?            @map("html_body") @db.Text
  textBody        String?            @map("text_body") @db.Text
  status          InboundEmailStatus @default(PENDING)
  processingError String?            @map("processing_error") @db.Text

  emailRuleId String?        @map("email_rule_id")
  emailRule   EmailRule?     @relation(fields: [emailRuleId], references: [id], onDelete: SetNull)
  ticketId    String?        @unique @map("ticket_id")
  ticket      SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  commentId   String?        @unique @map("comment_id")
  comment     TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([messageId])
  @@index([status, receivedAt])
  @@index([from])
  @@map("inbound_emails")
}

model OutboundEmail {
  id        String         @id @default(cuid())
  messageId String         @unique @map("message_id") // Generated Message-ID for tracking
  ticketId  String         @map("ticket_id")
  ticket    SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId String?        @map("comment_id")
  comment   TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  // Email details
  to        String
  subject   String
  emailType String @map("email_type") // "ticket_submitted", "ticket_comment", "ticket_assigned"

  sentAt DateTime @default(now()) @map("sent_at")

  @@index([messageId])
  @@index([ticketId])
  @@map("outbound_emails")
}

model TicketEmailParticipant {
  id       String        @id @default(cuid())
  ticketId String        @map("ticket_id")
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  email    String
  name     String?
  memberId String?       @map("member_id")
  member   Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  type     String        // 'from', 'to', 'cc'

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ticketId, email])
  @@index([ticketId])
  @@index([email])
  @@map("ticket_email_participants")
}

model TimeEntry {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String         @map("project_id")
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticketId       String?        @map("ticket_id")
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  taskName       String         @map("task_name")
  startTime      DateTime       @map("start_time")
  endTime        DateTime?      @map("end_time")
  durationMins   Int?           @map("duration_mins")
  isRunning      Boolean        @default(false) @map("is_running")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([organizationId, userId])
  @@index([organizationId, projectId])
  @@index([ticketId])
  @@map("time_entries")
}

// ==========================================
// Support Ticket Tables (Org-scoped)
// ==========================================

// DEPRECATED - kept for migration only, will be removed
enum TicketStatus {
  NEW_REQUEST
  IN_PROGRESS
  WAITING_FOR_INFO
  REVIEW
  RESOLVED
}

model TicketStage {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String // e.g., "New Requests", "In Progress"
  slug       String // e.g., "new_request", "in_progress"
  color      String // Tailwind color name, e.g., "purple", "blue"
  position   Int // Order in the Kanban board (0-indexed)
  isDefault  Boolean  @default(false) @map("is_default") // Default stage for new tickets
  isResolved Boolean  @default(false) @map("is_resolved") // Represents closed/completed
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tickets SupportTicket[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("ticket_stages")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestType {
  SOFTWARE_ISSUE
  HARDWARE_REQUEST
  ACCESS_REQUEST
  GENERAL_SUPPORT
  TECH_ADVICE
  OTHER
}

model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id")
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Contact info (stored for audit trail even if client is deleted)
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String
  phone     String?

  // Ticket info
  subject             String
  requestType         RequestType    @default(GENERAL_SUPPORT) @map("request_type")
  priorityLevel       TicketPriority @default(MEDIUM) @map("priority_level")
  description         String
  descriptionHtml     String?        @map("description_html") @db.Text
  screenRecordingLink String?        @map("screen_recording_link")

  // System fields
  status   TicketStatus @default(NEW_REQUEST) // DEPRECATED - use stageId instead
  stageId  String?      @map("stage_id")
  stage    TicketStage? @relation(fields: [stageId], references: [id])
  clientId String       @map("client_id")
  client   Member       @relation("TicketClient", fields: [clientId], references: [id], onDelete: Cascade)
  ownerId  String?      @map("owner_id")
  owner    Member?      @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate  DateTime?    @map("due_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  attachments TicketAttachment[]
  comments    TicketComment[]
  timeEntries TimeEntry[]

  // Email integration
  inboundEmail        InboundEmail?
  outboundEmails      OutboundEmail[]
  emailParticipants   TicketEmailParticipant[]

  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([organizationId, clientId])
  @@index([organizationId, ownerId])
  @@index([projectId])
  @@map("support_tickets")
}

model TicketAttachment {
  id           String         @id @default(cuid())
  ticketId     String         @map("ticket_id")
  ticket       SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?        @map("comment_id")
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName     String         @map("file_name")
  fileSize     Int            @map("file_size")
  fileType     String         @map("file_type")
  fileUrl      String         @map("file_url")
  isInline     Boolean        @default(false) @map("is_inline")
  contentId    String?        @map("content_id")
  uploadedById String         @map("uploaded_by_id")
  uploadedBy   Member         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("ticket_attachments")
}

model TicketComment {
  id          String             @id @default(cuid())
  ticketId    String             @map("ticket_id")
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String             @map("author_id")
  author      Member             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  contentHtml String?            @map("content_html") @db.Text
  isInternal  Boolean            @default(false) @map("is_internal")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  attachments TicketAttachment[]

  // Email integration
  inboundEmail   InboundEmail?
  outboundEmails OutboundEmail[]

  @@index([ticketId, isInternal])
  @@map("ticket_comments")
}

// ==========================================
// Software Catalog Tables (Global + Project-scoped)
// ==========================================

enum SoftwareCatalogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SoftwareAdminRole {
  OWNER
  ADMIN
}

enum SoftwareAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  REVOKED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CostType {
  PER_USER
  PER_ORGANIZATION
}

enum LicenseType {
  PER_SEAT
  ENTERPRISE
  FREE
  OTHER
}

// Global catalog managed by super-admin
model SoftwareCatalog {
  id            String                @id @default(cuid())
  name          String                @unique
  description   String?
  iconUrl       String?               @map("icon_url")
  vendor        String?
  websiteUrl    String?               @map("website_url")
  categoryId    String?               @map("category_id")
  category      SoftwareCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status        SoftwareCatalogStatus @default(PENDING)
  submittedById String?               @map("submitted_by_id")
  submittedBy   User?                 @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  projectSoftware ProjectSoftware[]

  @@map("software_catalog")
}

model SoftwareCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  software SoftwareCatalog[]

  @@map("software_categories")
}

// Software added to a PROJECT
model ProjectSoftware {
  id         String          @id @default(cuid())
  projectId  String          @map("project_id")
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  softwareId String          @map("software_id")
  software   SoftwareCatalog @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  notes      String?
  addedById  String          @map("added_by_id")
  addedBy    Member          @relation("ProjectSoftwareAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  // Renewal & Billing
  renewalDate  DateTime?     @map("renewal_date")
  billingCycle BillingCycle? @map("billing_cycle")
  cost         Decimal?      @db.Decimal(10, 2)
  costType     CostType?     @map("cost_type")
  autoRenewal  Boolean       @default(false) @map("auto_renewal")

  // License Management
  licenseType LicenseType? @map("license_type")
  totalSeats  Int?         @map("total_seats")

  // Vendor & Contract Info
  vendorContactEmail String? @map("vendor_contact_email")
  vendorContactPhone String? @map("vendor_contact_phone")
  contractUrl        String? @map("contract_url")
  loginUrl           String? @map("login_url")

  admins               ProjectSoftwareAdmin[]
  accessRequests       SoftwareAccessRequest[]
  renewalNotifications SoftwareRenewalNotification[]

  @@unique([projectId, softwareId])
  @@index([projectId])
  @@index([renewalDate])
  @@map("project_software")
}

// Admins for project software (can approve/decline requests)
model ProjectSoftwareAdmin {
  id                String            @id @default(cuid())
  projectSoftwareId String            @map("project_software_id")
  projectSoftware   ProjectSoftware   @relation(fields: [projectSoftwareId], references: [id], onDelete: Cascade)
  memberId          String            @map("member_id")
  member            Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role              SoftwareAdminRole @default(ADMIN)
  createdAt         DateTime          @default(now()) @map("created_at")

  @@unique([projectSoftwareId, memberId])
  @@map("project_software_admins")
}

// Access requests from clients for project software
model SoftwareAccessRequest {
  id                String                      @id @default(cuid())
  projectSoftwareId String                      @map("project_software_id")
  projectSoftware   ProjectSoftware             @relation(fields: [projectSoftwareId], references: [id], onDelete: Cascade)
  requesterId       String                      @map("requester_id")
  requester         Member                      @relation("SoftwareRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reason            String?
  status            SoftwareAccessRequestStatus @default(PENDING)
  assigneeId        String?                     @map("assignee_id")
  assignee          Member?                     @relation("SoftwareRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId        String?                     @map("reviewer_id")
  reviewer          Member?                     @relation("SoftwareReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNotes       String?                     @map("review_notes")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  @@index([projectSoftwareId])
  @@map("software_access_requests")
}

// Tracks which renewal notifications have been sent (prevents duplicates)
model SoftwareRenewalNotification {
  id                String          @id @default(cuid())
  projectSoftwareId String          @map("project_software_id")
  projectSoftware   ProjectSoftware @relation(fields: [projectSoftwareId], references: [id], onDelete: Cascade)
  threshold         String // "30_days", "14_days", "3_days", "1_day"
  renewalDate       DateTime        @map("renewal_date")
  sentAt            DateTime        @default(now()) @map("sent_at")

  @@unique([projectSoftwareId, threshold, renewalDate])
  @@index([projectSoftwareId])
  @@map("software_renewal_notifications")
}

// ==========================================
// Notification System
// ==========================================

model Notification {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientId    String       @map("recipient_id")
  recipient      Member       @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type    String // "ticket_assigned", "ticket_comment", "mention", etc.
  title   String
  message String
  link    String? // URL to navigate to

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Polymorphic reference to source entity
  entityType String? @map("entity_type") // "ticket", "comment", etc.
  entityId   String? @map("entity_id")

  @@index([recipientId, isRead])
  @@index([organizationId])
  @@index([recipientId, createdAt])
  @@map("notifications")
}
